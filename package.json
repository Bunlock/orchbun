{
  "name": "orchbun",
  "version": "0.2.0",
  "description": "Token-efficient orchestration for Codex, Claude Code, and OpenRouter agents",
  "private": true,
  "type": "module",
  "bin": {
    "orchbun": "dist/cli.js"
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
