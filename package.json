{
  "name": "orchbun",
  "version": "1.1.0",
  "description": "Local-first agent orchestration and auditable project memory for solo developers",
  "type": "module",
  "bin": {
    "orchbun": "dist/cli.js",
    "orchbun-mcp": "dist/mcp.js"
  },
  "exports": {
    "./memory": {
      "types": "./dist/memory-service.d.ts",
      "import": "./dist/memory-service.js"
    }
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "FAVICON.png",
    "ORCHBUN-logo.png"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "node dist/mcp.js",
    "test": "node --test --import tsx test/**/*.test.ts",
    "check": "tsc -p tsconfig.json --noEmit && node --test --import tsx test/**/*.test.ts",
    "prepack": "npm run check && npm run build"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "ajv": "^8.17.1",
    "yaml": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bunlock/orchbun.git"
  },
  "homepage": "https://github.com/Bunlock/orchbun#readme",
  "bugs": {
    "url": "https://github.com/Bunlock/orchbun/issues"
  },
  "keywords": [
    "agents",
    "ai-agents",
    "cli",
    "developer-tools",
    "local-first",
    "memory",
    "orchestration"
  ],
  "author": "Bunlock",
  "license": "MIT"
}
